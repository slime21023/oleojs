{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["dist/**", "docs/.vitepress/cache/**", "docs/.vitepress/dist/**"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["node:*", "bun", "bun:*", "cloudflare:*"],
            "message": "Portable code may use only ECMA-262 and ECMA-429 APIs (CONTRIBUTING.md, Standards conformance)."
          }
        ]
      }
    ],
    "no-restricted-globals": [
      "error",
      "process",
      "Buffer",
      "global",
      "require",
      "__dirname",
      "__filename",
      "setImmediate",
      "Deno",
      "Bun",
      "window",
      "document"
    ]
  },
  "overrides": [
    {
      "files": ["src/contract/**", "src/filters/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*", "bun", "bun:*", "cloudflare:*"],
                "message": "Portable code may use only ECMA-262 and ECMA-429 APIs (CONTRIBUTING.md, Standards conformance)."
              },
              {
                "group": ["../routing/*", "../http-method.ts"],
                "message": "Extensions use routing only through the public API (inspectRoutes, withRouteCheck) so third parties can build the same (docs/reference/extending.md)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/node/**", "test/node/**", "bench/**", "*.config.ts"],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-globals": "off"
      }
    }
  ]
}
